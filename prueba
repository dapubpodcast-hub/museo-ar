<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Prueba Tierra 3D</title>

    <script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>
</head>

<body>

<a-scene>

    <a-assets>
        <a-asset-item
            id="earth"
            src="modelos/earth.glb">
        </a-asset-item>
    </a-assets>

    <a-entity
        gltf-model="#earth"
        position="0 1.5 -3"
        scale="1 1 1">
    </a-entity>

    <a-camera position="0 1.6 0"></a-camera>

</a-scene>

</body>
</html>
